# Backend Environment Variables
# Copy to .env for development

# Server
PORT=8001
HOST=0.0.0.0

# CORS - comma-separated origins
ALLOWED_ORIGINS=http://localhost:3000

# NASA FIRMS API key (get free key at https://firms.modaps.eosdis.nasa.gov/api/)
FIRMS_API_KEY=

# Required for login, protected GIS tools, and persisted zones/alerts.
# Use a Postgres database with PostGIS enabled.
DATABASE_URL=
# Generate a long random value for production; never use the development fallback.
JWT_SECRET=

# ML Model path (relative to project root)
MODEL_PATH=models/production_model.pkl
